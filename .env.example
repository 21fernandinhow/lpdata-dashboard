# Endereço da API do LPData. Sem esta variável, o dashboard usa https://api.lpdata.io.
# Em desenvolvimento, o cliente chama /api, e o proxy do Vite repassa para este endereço:
# a API vê uma chamada de servidor e não precisa de localhost em LPDATA_CORS_ORIGINS.
# Em produção, o cliente chama este endereço direto.
VITE_LPDATA_API_URL=http://localhost:3000
